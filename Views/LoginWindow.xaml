<ui:FluentWindow x:Class="DataGateWin.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource App_Title}"
                 Height="540"
                 Width="760"
                 MinHeight="540"
                 MinWidth="760"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 Loaded="LoginWindow_OnLoaded">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar must be flush to window edge -->
        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource App_Title}"
                     ShowClose="True"
                     ShowMinimize="True"
                     ShowMaximize="False"/>

        <!-- Content area with padding -->
        <Grid Grid.Row="1"
              Margin="28"
              Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" LastChildFill="False">
                    <ui:TextBlock DockPanel.Dock="Left"
                                  VerticalAlignment="Center"
                                  Text="{DynamicResource Settings_Language}"
                                  FontWeight="SemiBold"/>
                    <ComboBox x:Name="LoginLanguageCombo"
                              DockPanel.Dock="Right"
                              MinWidth="280"
                              MaxWidth="420"
                              VerticalAlignment="Center"
                              SelectionChanged="LoginLanguageCombo_OnSelectionChanged"/>
                </DockPanel>
                <ui:Button Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Padding="0"
                           MinHeight="32"
                           MinWidth="32"
                           Height="{Binding ActualHeight, ElementName=LoginLanguageCombo, Mode=OneWay}"
                           Width="{Binding ActualHeight, ElementName=LoginLanguageCombo, Mode=OneWay}"
                           Appearance="Transparent"
                           ToolTip="{DynamicResource Home_ReportIssue}"
                           Click="ReportIssue_OnClick">
                    <ui:SymbolIcon Symbol="ChatHelp24"/>
                </ui:Button>
            </Grid>

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Top">
                <ui:Card Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="26" Margin="0,2,12,0"/>
                            <StackPanel>
                                <ui:TextBlock Text="{DynamicResource Login_Welcome}"
                                              FontTypography="Title"
                                              FontWeight="SemiBold"/>
                                <ui:TextBlock Text="{DynamicResource Login_SignInToContinue}"
                                              Opacity="0.75"
                                              Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Primary -->
                        <ui:Button Grid.Row="1"
                                   Height="46"
                                   Appearance="Primary"
                                   Command="{Binding SignInCommand}"
                                   IsEnabled="{Binding IsNotBusy}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="PersonAccounts24"/>
                            </ui:Button.Icon>
                            <ui:Button.Content>
                                <TextBlock Text="{DynamicResource Login_SignInGoogle}"/>
                            </ui:Button.Content>
                        </ui:Button>

                        <!-- Cancel only when busy -->
                        <ui:Button Grid.Row="2"
                                   Height="42"
                                   Margin="0,10,0,0"
                                   Appearance="Secondary"
                                   Command="{Binding CancelCommand}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24"/>
                            </ui:Button.Icon>
                            <ui:Button.Content>
                                <TextBlock Text="{DynamicResource Login_Cancel}"/>
                            </ui:Button.Content>
                        </ui:Button>

                        <!-- Status -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                            <ui:ProgressRing Width="18"
                                             Height="18"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            <ui:TextBlock Text="{Binding StatusText}"
                                          Margin="10,0,0,0"
                                          Opacity="0.85"
                                          TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <ui:Button Margin="0,14,0,0"
                           HorizontalAlignment="Right"
                           HorizontalContentAlignment="Center"
                           Padding="12,10"
                           Appearance="Secondary"
                           Click="TelegramChannel_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Width="20"
                                        Height="20"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Content="{StaticResource TelegramLogoMark}"/>
                        <TextBlock Text="{DynamicResource Telegram_SubscribeHint}"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>

            <!-- Footer -->
            <ui:TextBlock Grid.Row="3"
                          HorizontalAlignment="Stretch"
                          TextAlignment="Center"
                          TextWrapping="Wrap"
                          Opacity="0.55"
                          Margin="0,18,0,0"
                          Text="{DynamicResource Login_FooterHint}"/>
        </Grid>
    </Grid>
</ui:FluentWindow>

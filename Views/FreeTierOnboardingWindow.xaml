<ui:FluentWindow x:Class="DataGateWin.Views.FreeTierOnboardingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Free plan onboarding"
                 Width="560"
                 MinHeight="320"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Free/Default access onboarding"
                     ShowClose="True"
                     ShowMinimize="False"
                     ShowMaximize="False"/>

        <StackPanel Grid.Row="1" Margin="22,14,22,20">
            <ui:TextBlock x:Name="PlanText"
                          FontWeight="SemiBold"
                          Margin="0,0,0,6"/>

            <ui:TextBlock x:Name="RequiredChannelText"
                          Opacity="0.85"
                          TextWrapping="Wrap"
                          Margin="0,0,0,10"/>

            <WrapPanel Margin="0,0,0,12">
                <ui:Button x:Name="OpenChannelButton"
                           Height="34"
                           MinWidth="190"
                           Margin="0,0,10,0"
                           Appearance="Secondary"
                           Click="OpenChannel_OnClick"
                           Content="Open required channel"/>
                <ui:Button Height="34"
                           MinWidth="160"
                           Appearance="Primary"
                           Click="RefreshStatus_OnClick"
                           Content="I completed steps"/>
            </WrapPanel>

            <Separator Margin="0,0,0,12"/>

            <ui:TextBlock Text="Link Telegram account (optional alternative):"
                          FontWeight="SemiBold"
                          Margin="0,0,0,6"/>
            <ui:TextBlock Text="Enter your numeric Telegram ID from the same account that will use the bot."
                          Opacity="0.85"
                          TextWrapping="Wrap"
                          Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TelegramIdTextBox"
                         Grid.Column="0"
                         Height="34"
                         VerticalContentAlignment="Center"
                         ToolTip="Numeric Telegram ID"/>

                <ui:Button x:Name="RequestCodeButton"
                           Grid.Column="2"
                           Height="34"
                           MinWidth="150"
                           Appearance="Secondary"
                           Click="RequestCode_OnClick"
                           Content="Request link code"/>
            </Grid>

            <Border x:Name="LinkCodeBorder"
                    CornerRadius="8"
                    Padding="10"
                    Visibility="Collapsed"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <StackPanel>
                    <ui:TextBlock Text="Use this code in bot private chat:"
                                  Opacity="0.85"/>
                    <ui:TextBlock x:Name="LinkCodeText"
                                  FontSize="22"
                                  FontWeight="SemiBold"
                                  Margin="0,2,0,0"/>
                    <ui:TextBlock x:Name="LinkCodeExpiresText"
                                  Opacity="0.8"
                                  Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <ui:TextBlock x:Name="StatusText"
                          Margin="0,12,0,0"
                          TextWrapping="Wrap"
                          Opacity="0.85"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

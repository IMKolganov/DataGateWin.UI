<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Release: admin via UAC. Debug: asInvoker so F5/Cursor attaches to the real UI process. -->
    <ApplicationManifest Condition="'$(Configuration)'=='Debug'">app.manifest.debug.xml</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)'!='Debug'">app.manifest</ApplicationManifest>
    <ApplicationIcon>Images\favicon.ico</ApplicationIcon>
    <AssemblyVersion>1.0.14</AssemblyVersion>
    <FileVersion>1.0.14</FileVersion>
    <Product>DataGate</Product>
    <AssemblyTitle>DataGate</AssemblyTitle>
    <Description>DataGate</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="DataGateMonitor.SharedModels" Version="1.0.63" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataGateWin.Core\DataGateWin.Core.csproj" />
    <ProjectReference Include="..\DataGateWin.CrashReporting\DataGateWin.CrashReporting.csproj" />
  </ItemGroup>

  <!-- Portable logic compiles in DataGateWin.Core; keep WPF-only sources here. -->
  <ItemGroup>
    <Compile Remove="Configuration\**\*.cs" />
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Ipc\EngineIpcClient.cs" />
    <Compile Remove="Localization\CultureMapping.cs" />
    <Compile Remove="Localization\UiLocale.cs" />
    <Compile Remove="Localization\Loc.cs" />
    <Compile Remove="Services\Auth\**\*.cs" />
    <Compile Remove="Services\Access\**\*.cs" />
    <Compile Remove="Services\Ipc\**\*.cs" />
    <!-- WPF MessageBox / Window dialog — not in Core -->
    <Compile Include="Services\Ipc\EngineMissingUi.cs" />
    <Compile Remove="Services\VpnServers\**\*.cs" />
    <Compile Remove="Services\OpenVpnFiles\**\*.cs" />
    <Compile Remove="Services\IpList\**\*.cs" />
    <Compile Remove="Services\Statistics\**\*.cs" />
    <Compile Remove="Services\Support\**\*.cs" />
    <Compile Remove="Services\Installation\**\*.cs" />
    <Compile Remove="Services\Identity\**\*.cs" />
    <Compile Remove="Services\Update\AppInstallerLocator.cs" />
    <Compile Remove="Services\Update\ReleaseVersionParser.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataGateWin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\IpLists\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Wintun amd64 DLL: must sit next to engine.exe (LoadLibraryEx APPLICATION_DIR). Vendor: wintun.net -->
    <None Include="..\drivers\wintun\wintun.dll" Link="engine\wintun.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Pages\SettingsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Pages\Home\HomePage.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>
